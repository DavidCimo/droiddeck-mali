       vk->GetPhysicalDeviceExternalBufferProperties(handle, &info, &props);
+      const VkExternalMemoryProperties *p = &props.externalMemoryProperties;
+      vkr_log("dma_buf buffer: features 0x%x exportFrom 0x%x compatible 0x%x",
