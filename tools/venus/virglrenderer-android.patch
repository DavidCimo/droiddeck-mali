-         (props.externalMemoryProperties.exportFromImportedHandleTypes &
+         (p->externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) &&
+         ((p->exportFromImportedHandleTypes | p->compatibleHandleTypes) &
           VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT);
    }
+   vkr_log("memory export: dma_buf %d opaque_fd %d",
+           physical_dev->is_dma_buf_fd_export_supported,
+           physical_dev->is_opaque_fd_export_supported);
 
