diff --git a/src/virtio/vulkan/vn_sync.c b/src/virtio/vulkan/vn_sync.c
index ee0a539..face729 100644
--- a/src/virtio/vulkan/vn_sync.c
+++ b/src/virtio/vulkan/vn_sync.c
@@ -49,6 +49,24 @@ vn_sync_payload_release(struct vn_device *dev,
    vn_sync_payload_release_internal(dev, payload, NULL);
 }
 
+/* vtest cannot export a sync_file: wait for the payload on the CPU and
+ * return -1, the sync fd that stands for an already signaled payload.
+ */
+static int
+vn_sync_export_signaled(struct vn_device *dev, struct vn_renderer_sync *sync)
+{
+   uint64_t val = 1;
+   const struct vn_renderer_wait wait = {
+      .timeout = UINT64_MAX,
+      .syncs = &sync,
+      .sync_values = &val,
+      .sync_count = 1,
+   };
+   vn_renderer_wait(dev->renderer, &wait);
+   vn_renderer_sync_reset(dev->renderer, sync);
+   return -1;
+}
+
 /* fence commands */
 
 static VkResult
@@ -298,7 +316,10 @@ vn_GetFenceFdKHR(VkDevice device,
    assert(sync_file);
 
    int fd = -1;
-   if (payload->type == VN_SYNC_TYPE_SYNC) {
+   if (payload->type == VN_SYNC_TYPE_SYNC &&
+       !dev->renderer->info.has_external_sync) {
+      fd = vn_sync_export_signaled(dev, payload->sync);
+   } else if (payload->type == VN_SYNC_TYPE_SYNC) {
       fd = vn_renderer_sync_export_syncobj(dev->renderer,
                                            fence->payload->sync, sync_file);
       vn_renderer_sync_reset(dev->renderer, fence->payload->sync);
@@ -830,7 +851,11 @@ vn_GetSemaphoreFdKHR(VkDevice device,
    assert(sync_file);
 
    int fd = -1;
-   if (payload->type == VN_SYNC_TYPE_SYNC) {
+   if (payload->type == VN_SYNC_TYPE_SYNC &&
+       !dev->renderer->info.has_external_sync) {
+      assert(sem->sync_fd_export);
+      fd = vn_sync_export_signaled(dev, payload->sync);
+   } else if (payload->type == VN_SYNC_TYPE_SYNC) {
       assert(sem->sync_fd_export);
       fd = vn_renderer_sync_export_syncobj(dev->renderer, payload->sync,
                                            sync_file);
